# Copy to .env and fill in. Never commit the real .env file.

# GitHub personal access token (fine-grained, scoped to just this repo,
# Contents: Read and write) — optional for GitHub API publish endpoints.
# Local "Sync Selected to Plugin" does not require this.
GITHUB_TOKEN=

# Defaults shown below; override only if you fork this to a different repo.
GITHUB_OWNER=hanseldoan
GITHUB_REPO=starbucks-photo-library
GITHUB_BRANCH=main

# Shared secret for the scheduled scrape+publish endpoint
# (/api/cron/scrape-and-publish). Make up any random string. Set the same
# value here and wherever calls that endpoint (Render Cron Job or the
# GitHub Actions workflow in .github/workflows/monthly-scrape.yml).
CRON_SECRET=

PORT=3000
